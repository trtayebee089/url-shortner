APP_NAME=247URL
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=http://localhost:3000
# OAuth credentials belong on the Laravel server only. Register exact callback URLs with each provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
# Apple web callbacks require an HTTPS domain; localhost is not accepted by Apple.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=
APPLE_REDIRECT_URI=
# Canonical public short-link origin. Keep this separate from APP_URL.
SHORT_URL_DOMAIN=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=url_shortener
DB_USERNAME=url_shortener
DB_PASSWORD=
DB_COLLATION=utf8mb4_bin

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_ENCRYPT=true
SANCTUM_TOKEN_PREFIX=247url_
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:3000
# Comma-separated proxy IPs/CIDRs. Never use * unless the app port is private behind a trusted proxy.
TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=url_shortener_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

ALLOW_ANONYMOUS_LINKS=true
SHORT_CODE_LENGTH=7
SHORT_CODE_MAX_ATTEMPTS=8
SHORT_REDIRECT_STATUS=302
SHORT_LINK_CACHE_TTL=3600
SHORT_LINK_NEGATIVE_CACHE_TTL=60
SHORT_RESERVED_ALIASES=admin,api,login,register,dashboard,settings,pricing,about,contact,terms,privacy,auth,logout,robots.txt,sitemap.xml,features,faq,resources,verify-email,forgot-password,reset-password,blog,docs
SHORT_BLOCKED_DOMAINS=
RATE_LIMIT_ANONYMOUS_CREATE=10
RATE_LIMIT_AUTHENTICATED_CREATE=60
RATE_LIMIT_API=120
RATE_LIMIT_AUTH=5
RATE_LIMIT_SOCIAL_AUTH=18
RATE_LIMIT_PASSWORD_RESET=3
RATE_LIMIT_ANALYTICS=60
RATE_LIMIT_ABUSE_REPORTS=6
RATE_LIMIT_VERIFICATION=6
ANALYTICS_RETENTION_DAYS=90
ANALYTICS_HASH_KEY=
ANALYTICS_TRUST_GEO_HEADERS=false
ANALYTICS_STORE_LOCATION=false
CORS_ALLOWED_ORIGINS=http://localhost:3000

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# Optional and development-only. If omitted, the seeded demo account gets a random unknown password.
DEMO_USER_PASSWORD=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
